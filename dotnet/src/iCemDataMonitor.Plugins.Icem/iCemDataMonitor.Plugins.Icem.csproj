<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>iCemDataMonitor.Plugins.Icem</RootNamespace>
    <AssemblyName>iCemDataMonitor.Plugins.Icem</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\iCemDataMonitor.Sdk\iCemDataMonitor.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\shared\catalogs\host\**\*.ssf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>templates\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="..\..\..\shared\catalogs\host\variable_registry.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>templates\variable_registry.json</Link>
    </Content>
    <Content Include="..\..\..\shared\catalogs\host\lantable_registry.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>templates\lantable_registry.json</Link>
    </Content>
  </ItemGroup>

</Project>
