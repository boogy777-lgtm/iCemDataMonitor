<Project Sdk="Microsoft.NET.Sdk">

  <!-- WinUI 3 shell (W9 migration): unpackaged, self-contained — no VS, no
       installed Windows App SDK runtime required on the stand (Win10 1809+).
       Build: dotnet build -p:Platform=x64

       D.5 (BD-hybrid): the shell is a CLIENT of iCemDataMonitor.Host.exe.
       GAP-2 closed — the in-proc backend is GONE from this project:
         - NO AspNetCore FrameworkReference (no Kestrel here anymore);
          - NO wwwroot content copy (the web SPA is retired 2026-08-27,
            WebApp project deleted; the corrected-decree «Панель» tab only
            BROWSES the host's dashboard via WebView2 — no Kestrel here);
         - NO Host.Core reference (LayerRuntimeController/StationHealthState
           were the in-proc control plane; control now = gRPC SetLayer RPC).
       TFM net10.0-windows10.0.19041.0 per owner directive (spike D.1.0a GREEN).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>iCemDataMonitor.Shell.WinUI</RootNamespace>
    <AssemblyName>iCemDataMonitor.WinUI</AssemblyName>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\assets\iCemDataMonitor.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Nearest-compatible under net10 (no net10 assets yet): ReactiveUI max
         net8 — runtime verified on the stand per D.5. P1 (2026-08-26):
         H.NotifyIcon.WinUI REMOVED — single tray owner = Host, the shell has
         no tray icon. 2026-08-27 (CORRECTED decree): the embedded-browser
         package is BACK — the «Панель» tab (WebView2 over the host's web SPA)
         was removed by a misreading of the decree and is restored the same
         day; the emulator UI library reference stays REMOVED (the emulator is
         an independent app). -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="ReactiveUI" Version="19.5.41" />
    <!-- «Панель» embedded browser (corrected decree 2026-08-27). Version =
         the MAX already present in the local nuget cache (offline-first):
         %USERPROFILE%\.nuget\packages\microsoft.web.webview2 → 1.0.4129.50
         (older cached: 1.0.3179.45). -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\iCemDataMonitor.Core\iCemDataMonitor.Core.csproj" />
    <!-- D.5: host client library (gRPC pipe channel, reconnect FSM,
         ensure-host decision table, status VM). -->
    <ProjectReference Include="..\iCemDataMonitor.HostClient\iCemDataMonitor.HostClient.csproj" />
    <!-- TOMBSTONE (2026-08-27): the emulator UI library ProjectReference is
         REMOVED — the «Эмулятор» tab (in-proc EmulatorPage) is gone; the
         emulator is a separate independent app with its own UI and its own
         folder. -->
  </ItemGroup>

  <!-- App icon file for AppWindow.SetIcon at runtime -->
  <ItemGroup>
    <Content Include="..\assets\iCemDataMonitor.ico" Link="iCemDataMonitor.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- TOMBSTONE (2026-08-27): DeployEmuleEngine target REMOVED — the emulator
       is a separate independent app that deploys itself into its own folder;
       the shell no longer builds/copies iCemEmule engine bits into its output.

       P1 2026-08-26 («ярлык iCem Data Monitor — ничего не происходит»):
       dotnet publish DROPS the app's own compiled XAML resources when a WinUI
       class library is referenced (the app .pri and loose .xbf stay in
       $(OutDir) but never reach the publish output). Without them
       Application.InitializeComponent cannot resolve ms-appx:///App.xaml and
       the exe dies silently at startup. Copy the app .pri, loose .xbf/.xaml
       into the publish output — additive, idempotent, safe for both -o and
       default publish dirs. With the emulator UI library reference gone the
       library-loose-resources copy (_ShellPublishEmuLoose) is removed too —
       the shell ships ONLY its own App/MainWindow/ThemeResources/
       BootSplashWindow resources. -->
  <Target Name="EnsureWinUIResourcesInPublish" AfterTargets="Publish">
    <ItemGroup>
      <_ShellPublishPri Include="$(OutDir)*.pri" />
      <_ShellPublishXbf Include="$(OutDir)*.xbf" />
      <_ShellPublishXaml Include="$(OutDir)*.xaml" />
    </ItemGroup>
    <Copy SourceFiles="@(_ShellPublishPri)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_ShellPublishXbf)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_ShellPublishXaml)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
