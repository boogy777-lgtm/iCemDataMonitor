<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ W9.2 macOS tokens (Inside_UI_KIT) for the WinUI 3 desktop UI ═══
         DYNAMIC: ThemeDictionaries resolve per OS light/dark theme — the same
         palette the web dashboard consumes via CSS variables and the WinForms
         surfaces consume via UiTokens.cs. ONE design source, three surfaces. -->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="MacAccentColor">#FF0091FF</Color>
            <SolidColorBrush x:Key="MacAccentBrush" Color="#FF0091FF"/>
            <Color x:Key="MacGreenColor">#FF30D158</Color>
            <SolidColorBrush x:Key="MacGreenBrush" Color="#FF30D158"/>
            <Color x:Key="MacRedColor">#FFFF4245</Color>
            <SolidColorBrush x:Key="MacRedBrush" Color="#FFFF4245"/>
            <Color x:Key="MacOrangeColor">#FFFF9230</Color>
            <SolidColorBrush x:Key="MacOrangeBrush" Color="#FFFF9230"/>
            <Color x:Key="MacYellowColor">#FFFFD600</Color>
            <SolidColorBrush x:Key="MacYellowBrush" Color="#FFFFD600"/>
            <Color x:Key="MacWindowColor">#FF1E1E1E</Color>
            <SolidColorBrush x:Key="MacWindowBrush" Color="#FF1E1E1E"/>
            <Color x:Key="MacSurfaceColor">#FF2C2C2E</Color>
            <SolidColorBrush x:Key="MacSurfaceBrush" Color="#FF2C2C2E"/>
            <Color x:Key="MacSurface2Color">#FF272729</Color>
            <SolidColorBrush x:Key="MacSurface2Brush" Color="#FF272729"/>
            <Color x:Key="MacLabelColor">#FFF5F5F5</Color>
            <SolidColorBrush x:Key="MacLabelBrush" Color="#FFF5F5F5"/>
            <Color x:Key="MacLabel2Color">#FF999999</Color>
            <SolidColorBrush x:Key="MacLabel2Brush" Color="#FF999999"/>
            <Color x:Key="MacLabel3Color">#FF666666</Color>
            <SolidColorBrush x:Key="MacLabel3Brush" Color="#FF666666"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="MacAccentColor">#FF007AFF</Color>
            <SolidColorBrush x:Key="MacAccentBrush" Color="#FF007AFF"/>
            <Color x:Key="MacGreenColor">#FF28CD41</Color>
            <SolidColorBrush x:Key="MacGreenBrush" Color="#FF28CD41"/>
            <Color x:Key="MacRedColor">#FFFF3B30</Color>
            <SolidColorBrush x:Key="MacRedBrush" Color="#FFFF3B30"/>
            <Color x:Key="MacOrangeColor">#FFFF9500</Color>
            <SolidColorBrush x:Key="MacOrangeBrush" Color="#FFFF9500"/>
            <Color x:Key="MacYellowColor">#FFE6C200</Color>
            <SolidColorBrush x:Key="MacYellowBrush" Color="#FFE6C200"/>
            <Color x:Key="MacWindowColor">#FFF5F5F7</Color>
            <SolidColorBrush x:Key="MacWindowBrush" Color="#FFF5F5F7"/>
            <Color x:Key="MacSurfaceColor">#FFFFFFFF</Color>
            <SolidColorBrush x:Key="MacSurfaceBrush" Color="#FFFFFFFF"/>
            <Color x:Key="MacSurface2Color">#FFF0F0F2</Color>
            <SolidColorBrush x:Key="MacSurface2Brush" Color="#FFF0F0F2"/>
            <Color x:Key="MacLabelColor">#D9000000</Color>
            <SolidColorBrush x:Key="MacLabelBrush" Color="#D9000000"/>
            <Color x:Key="MacLabel2Color">#99000000</Color>
            <SolidColorBrush x:Key="MacLabel2Brush" Color="#99000000"/>
            <Color x:Key="MacLabel3Color">#66000000</Color>
            <SolidColorBrush x:Key="MacLabel3Brush" Color="#66000000"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <Color x:Key="MacAccentColor">#FFFFFFFF</Color>
            <SolidColorBrush x:Key="MacAccentBrush" Color="#FFFFFFFF"/>
            <Color x:Key="MacGreenColor">#FFFFFFFF</Color>
            <SolidColorBrush x:Key="MacGreenBrush" Color="#FFFFFFFF"/>
            <Color x:Key="MacRedColor">#FFFFFFFF</Color>
            <SolidColorBrush x:Key="MacRedBrush" Color="#FFFFFFFF"/>
            <Color x:Key="MacOrangeColor">#FFFFFFFF</Color>
            <SolidColorBrush x:Key="MacOrangeBrush" Color="#FFFFFFFF"/>
            <Color x:Key="MacYellowColor">#FFFFFFFF</Color>
            <SolidColorBrush x:Key="MacYellowBrush" Color="#FFFFFFFF"/>
            <Color x:Key="MacWindowColor">#FF000000</Color>
            <SolidColorBrush x:Key="MacWindowBrush" Color="#FF000000"/>
            <Color x:Key="MacSurfaceColor">#FF000000</Color>
            <SolidColorBrush x:Key="MacSurfaceBrush" Color="#FF000000"/>
            <Color x:Key="MacSurface2Color">#FF000000</Color>
            <SolidColorBrush x:Key="MacSurface2Brush" Color="#FF000000"/>
            <Color x:Key="MacLabelColor">#FFFFFFFF</Color>
            <SolidColorBrush x:Key="MacLabelBrush" Color="#FFFFFFFF"/>
            <Color x:Key="MacLabel2Color">#FFFFFFFF</Color>
            <SolidColorBrush x:Key="MacLabel2Brush" Color="#FFFFFFFF"/>
            <Color x:Key="MacLabel3Color">#FFFFFFFF</Color>
            <SolidColorBrush x:Key="MacLabel3Brush" Color="#FFFFFFFF"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Typography + metrics (kit Tokens/Typography + Metrics) -->
    <FontFamily x:Key="MacFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MacFontMono">Consolas</FontFamily>
    <x:Double x:Key="MacFontSizeBody">13</x:Double>
    <x:Double x:Key="MacFontSizeSecondary">12</x:Double>
    <x:Double x:Key="MacFontSizeCaption">11</x:Double>
    <x:Double x:Key="MacControlHeight">24</x:Double>
    <x:Double x:Key="MacSpacingXS">4</x:Double>
    <x:Double x:Key="MacSpacingS">8</x:Double>
    <x:Double x:Key="MacSpacingR">12</x:Double>
    <x:Double x:Key="MacSpacingM">16</x:Double>
    <CornerRadius x:Key="MacRadius">6</CornerRadius>
    <CornerRadius x:Key="MacRadiusSmall">4</CornerRadius>

</ResourceDictionary>
