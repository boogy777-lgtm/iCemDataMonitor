{
  "workloads": {
    "legacy": [
      "legacy"
    ],
    "rust": [
      "rust",
      "packaging"
    ],
    "shared-contracts": [
      "legacy",
      "rust",
      "packaging"
    ],
    "packaging": [
      "rust",
      "packaging"
    ],
    "infrastructure": [
      "legacy",
      "rust",
      "packaging"
    ],
    "documentation": []
  },
  "rules": [
    {
      "category": "infrastructure",
      "paths": [
        ".github/**",
        "rust/migration/**",
        "rust/tools/ci/**"
      ]
    },
    {
      "category": "shared-contracts",
      "paths": [
        "iCemEmule.Core/**",
        "iCemDataMonitor.Contracts/**",
        "specs/**",
        "assets/**",
        "iCemEmulator/templates/**",
        "templates/**",
        "iCemDataMonitor.Plugins.Icem/LantableRegistry.cs",
        "iCemDataMonitor.Plugins.Icem/templates/**",
        "docs/Wireshark/**",
        "Directory.Build.props",
        "Directory.Build.targets",
        "global.json",
        "iCemDataMonitor.Host/wwwroot/**",
        "iCemDataMonitor.Sdk/Bus/**",
        "iCemDataMonitor.Sdk/Models/ModbusRegisterEntry.cs",
        "iCemDataMonitor.Sdk/IModbusPublisher.cs",
        "iCemDataMonitor.Transport/Modbus*.cs",
        "iCemDataMonitor.Transport/Models/Modbus*.cs",
        "iCemDataMonitor.Host/Grpc/**",
        "iCemDataMonitor.Host.Core/Endpoints/**",
        "rust/contracts/**",
        "rust/crates/icem-bus/**",
        "rust/crates/icem-protocols/**",
        "rust/migration/**",
        "iCemDataMonitor.Data/Bus/**",
        "iCemDataMonitor.Data/Telemetry/RegisterDecoder.cs"
      ]
    },
    {
      "category": "packaging",
      "paths": [
        "installer/**",
        "Burservis.iCem.DataMonitor/**",
        "rust/installer/**",
        "rust/tools/Build-Windows*.ps1",
        "rust/tools/Build-LegacyAddin.ps1",
        "rust/tools/WindowsPackagingFixture.psm1",
        "rust/tools/Test-Windows*.ps1"
      ],
      "exclude": [
        "rust/installer/README.md"
      ]
    },
    {
      "category": "documentation",
      "paths": [
        "README.md",
        "PROTOCOL.md",
        "AGENTS.md",
        "docs/*.md",
        "docs/images/*.svg",
        "rust/*.md",
        "rust/docs/*.md",
        "rust/installer/README.md"
      ]
    },
    {
      "category": "rust",
      "paths": [
        "rust/**"
      ],
      "exclude": [
        "README.md",
        "PROTOCOL.md",
        "AGENTS.md",
        "docs/*.md",
        "rust/*.md",
        "rust/docs/*.md",
        "rust/installer/README.md"
      ]
    },
    {
      "category": "legacy",
      "paths": [
        "Burservis.iCem.DataMonitor.Tests/**",
        "Burservis.iCem.DataMonitor/**",
        "iCemDataMonitor.Contracts.Tests/**",
        "iCemDataMonitor.Contracts/**",
        "iCemDataMonitor.Core.Tests/**",
        "iCemDataMonitor.Core/**",
        "iCemDataMonitor.Data.Tests/**",
        "iCemDataMonitor.Data/**",
        "iCemDataMonitor.Emulator.WinUI/**",
        "iCemDataMonitor.Host.Core/**",
        "iCemDataMonitor.Host.Tests/**",
        "iCemDataMonitor.Host/**",
        "iCemDataMonitor.HostClient/**",
        "iCemDataMonitor.Plugins.Icem.Tests/**",
        "iCemDataMonitor.Plugins.Icem/**",
        "iCemDataMonitor.Sdk.Tests/**",
        "iCemDataMonitor.Sdk/**",
        "iCemDataMonitor.Shell.WinUI/**",
        "iCemDataMonitor.Tools.IconGen/**",
        "iCemDataMonitor.Transport.Tests/**",
        "iCemDataMonitor.Transport/**",
        "iCemDataMonitor.UI.Tests/**",
        "iCemEmulator/**",
        "iCemEmule.Core/**",
        "iCemEmule.Tests/**",
        "scripts/**",
        "installer/**"
      ],
      "extensions": [
        ".cs",
        ".csproj",
        ".json",
        ".xaml",
        ".ps1",
        ".bmp",
        ".js",
        ".ico",
        ".png",
        ".manifest",
        ".csv",
        ".sha256",
        ".proto",
        ".html",
        ".css",
        ".bat",
        ".wxs",
        ".ssf"
      ]
    },
    {
      "category": "legacy",
      "paths": [
        "CI.slnf",
        "iCemDataMonitor.sln",
        "VERSION",
        "build.ps1",
        "installer/**",
        "Burservis.iCem.DataMonitor/**"
      ]
    }
  ]
}
