+// Preserve OPC positive rate status outside the service Error policy.
+fn rate_result(result: AbiResult<()>, unsupported: bool) -> AbiResult<()> {
+    if result.is_ok() && unsupported {
+        Err(AbiError::from_hresult(HRESULT(0x0004000d)))
+    } else {
+        result
+    }
