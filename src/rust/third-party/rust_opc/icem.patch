+//! iCem SDK extension: native DA callback boundary. See ADR0019.
+use super::callback_health::{CallbackMonitor, WorkerLease};
+use super::callback_queue::{DeliveryQueue, MAX_ITEMS, MAX_SINKS, Preparation, QueueError};
+use super::*;
+use crate::{IOPCAsyncIO2_Impl, IOPCDataCallback};
+use std::{
+    collections::BTreeMap,
+    sync::{
+        Condvar,
+        atomic::{AtomicBool, AtomicU64},
+    },
+    time::{Duration, Instant},
+};
+use windows::Win32::System::Com::{
+    CLSCTX_INPROC_SERVER, CoCreateInstance, IConnectionPoint, IConnectionPoint_Impl,
+    IConnectionPointContainer, IConnectionPointContainer_Impl, IEnumConnectionPoints,
+    IEnumConnections, IGlobalInterfaceTable,
+};
+use windows_core::IUnknownImpl;
+const NO_CONNECTION: HRESULT = HRESULT(0x80040200_u32.cast_signed());
+const ADVISE_LIMIT: HRESULT = HRESULT(0x80040201_u32.cast_signed());
+const CANNOT_CONNECT: HRESULT = HRESULT(0x80040202_u32.cast_signed());
+const FAIL: HRESULT = HRESULT(0x80004005_u32.cast_signed());
+const GIT_CLASS: GUID = GUID::from_u128(0x00000323_0000_0000_c000_000000000046);
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Kind {
+    Change,
+    Refresh,
+    Read,
+    Cancel,
+}
+struct Frame {
+    kind: Kind,
+    transaction: u32,
+    group: u32,
+    samples: Vec<ServerSample>,
+    revision: u64,
+    epoch: u64,
+}
+// The baseline describes delivered data, never merely sampled/queued data.
+// A candidate is bounded by validate_frame before entering this state.
+#[derive(Default)]
+struct PeriodicBaseline {
+    samples: Vec<ServerSample>,
+    group: Option<u32>,
+    pending: Option<Vec<ServerSample>>,
+}
+impl PeriodicBaseline {
+    fn changed(&mut self, samples: Vec<ServerSample>, group: u32) -> Vec<ServerSample> {
+        let changed = samples
+            .iter()
+            .enumerate()
+            .filter(|(i, s)| {
+                self.group != Some(group) || self.samples.get(*i).is_none_or(|p| !same_sample(p, s))
+            })
+            .map(|(_, s)| s.clone())
+            .collect::<Vec<_>>();
+        self.pending = if changed.is_empty() {
+            None
+        } else {
+            Some(samples)
+        };
+        changed
+    }
+    fn delivered(&mut self, frame: &Frame) {
+        match frame.kind {
+            Kind::Change => {
+                if let Some(samples) = self.pending.take() {
+                    self.samples = samples;
+                    self.group = Some(frame.group);
+                }
+            }
+            Kind::Refresh => {
+                self.samples = frame.samples.clone();
+                self.group = Some(frame.group);
+                self.pending = None;
+            }
+            Kind::Read | Kind::Cancel => {}
+        }
+    }
+    fn clear(&mut self) {
+        self.samples.clear();
+        self.group = None;
+        self.pending = None;
+    }
+}
+type Sink = super::callback_queue::Sink<Arc<Frame>>;
+type Members = super::callback_queue::Members<Arc<Frame>>;
+pub(crate) struct Callbacks {
+    members: Mutex<Members>,
+    enabled: AtomicBool,
+    revision: AtomicU64,
+    epoch: AtomicU64,
+    monitor: CallbackMonitor,
+}
+fn admission_error(reason: QueueError) -> AbiError {
+    error(match reason {
+        QueueError::Closed => NO_CONNECTION,
+        QueueError::Full => ADVISE_LIMIT,
+        QueueError::Unknown | QueueError::Poisoned => E_UNEXPECTED,
+    })
+}
+fn error(code: HRESULT) -> AbiError {
+    AbiError::from_hresult(code)
+}
+fn boundary<T>(f: impl FnOnce() -> AbiResult<T>) -> AbiResult<T> {
+    serve(|| f().map_err(crate::abi::from_abi_error))
+}
+fn git() -> AbiResult<IGlobalInterfaceTable> {
+    // SAFETY: standard GIT class, generated typed interface; caller initialized COM.
+    unsafe { CoCreateInstance(&GIT_CLASS, None, CLSCTX_INPROC_SERVER) }
+}
+struct Registration<'a> {
+    table: IGlobalInterfaceTable,
+    cookie: Option<u32>,
+    lease: &'a WorkerLease,
+}
+impl Drop for Registration<'_> {
+    fn drop(&mut self) {
+        if let Some(cookie) = self.cookie.take() {
+            self.lease.begin(Instant::now());
+            // SAFETY: registration exclusively owned here; initialized current apartment.
+            if unsafe { self.table.RevokeInterfaceFromGlobal(cookie) }.is_err() {
+                self.lease.fail();
+            }
+            self.lease.finish();
+        }
+    }
+}
+struct Proxy<'a> {
+    inner: Option<IOPCDataCallback>,
+    lease: &'a WorkerLease,
+}
+impl Drop for Proxy<'_> {
+    fn drop(&mut self) {
+        self.lease.begin(Instant::now());
+        drop(self.inner.take());
+        self.lease.finish();
+    }
+}
+impl Callbacks {
+    pub(crate) fn new(monitor: CallbackMonitor) -> Arc<Self> {
+        Arc::new(Self {
+            members: Mutex::new(Members {
+                sinks: BTreeMap::new(),
+                requests: BTreeMap::new(),
+                next_cookie: 1,
+                next_cancel: 1,
+                closed: false,
+            }),
+            enabled: AtomicBool::new(true),
+            revision: AtomicU64::new(1),
+            epoch: AtomicU64::new(1),
+            monitor,
+        })
+    }
+    pub(crate) fn invalidate(&self) {
+        self.revision.fetch_add(1, Ordering::AcqRel);
+    }
+    pub(crate) fn close(&self) {
+        if let Ok(mut m) = self.members.lock() {
+            m.closed = true;
+            for sink in m.sinks.values() {
+                close_sink(sink);
+            }
+            m.sinks.clear();
+            m.requests.clear();
+        }
+    }
+    fn advise(
+        self: &Arc<Self>,
+        object: &IUnknown,
+        service: Arc<dyn DaGroupService>,
+        state: Arc<Mutex<GroupState>>,
+    ) -> AbiResult<u32> {
+        let lease = self.monitor.worker().ok_or_else(|| error(ADVISE_LIMIT))?;
+        lease.begin(Instant::now());
+        let callback: IOPCDataCallback = object.cast().map_err(|_| error(CANNOT_CONNECT))?;
+        let table = git()?;
+        // SAFETY: exact QI callback reference and IID in calling Advise apartment.
+        let cookie = unsafe { table.RegisterInterfaceInGlobal(&callback, &IOPCDataCallback::IID) }?;
+        // Own rollback before any further operation (including Release) can unwind.
+        let mut registration = Registration {
+            table,
+            cookie: Some(cookie),
+            lease: &lease,
+        };
+        // Release caller QI reference before worker startup: covered by busy lease.
+        drop(callback);
+        let result = self.spawn(cookie, lease.clone(), service, state);
+        if result.is_ok() {
+            // Successful channel send transferred the scalar cookie to an initialized
+            // worker that already owns its apartment-local GIT table. No COM proxy crosses.
+            registration.cookie = None;
+        }
+        result
+    }
+
+    fn spawn(
+        self: &Arc<Self>,
+        git_cookie: u32,
+        lease: WorkerLease,
+        service: Arc<dyn DaGroupService>,
+        state: Arc<Mutex<GroupState>>,
+    ) -> AbiResult<u32> {
+        let mut m = self.members.lock().map_err(|_| error(E_UNEXPECTED))?;
+        if m.closed || m.sinks.len() >= MAX_SINKS || m.next_cookie == u32::MAX {
+            return Err(error(ADVISE_LIMIT));
+        }
+        let cookie = m.next_cookie;
+        m.next_cookie += 1;
+        let sink = Arc::new(Sink {
+            queue: Mutex::new(DeliveryQueue::new()),
+            wake: Condvar::new(),
+            closed: AtomicBool::new(false),
+        });
+        let worker_sink = sink.clone();
+        let owner = Arc::downgrade(self);
+        let (ready_tx, ready_rx) = std::sync::mpsc::sync_channel(0);
+        let (start_tx, start_rx) = std::sync::mpsc::sync_channel(0);
+        std::thread::Builder::new()
+            .name("opc-da-callback".into())
+            .stack_size(256 * 1024)
+            .spawn(move || {
+                if std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                    worker(
+                        start_rx,
+                        ready_tx,
+                        &lease,
+                        &worker_sink,
+                        owner,
+                        service,
+                        state,
+                    )
+                }))
+                .is_err()
+                {
+                    lease.fail();
+                }
+            })
+            .map_err(|_| error(E_OUTOFMEMORY))?;
+        m.sinks.insert(cookie, sink);
+        drop(m);
+        // Never wait for COM initialization while holding membership/queue/state locks.
+        // Caller still owns registration rollback until the worker accepts the cookie.
+        if ready_rx.recv().is_err() || start_tx.send(git_cookie).is_err() {
+            let _ = self.unadvise(cookie);
+            return Err(error(E_UNEXPECTED));
+        }
+        Ok(cookie)
+    }
+    fn retire(&self, sink: &Sink) {
+        if let Ok(mut m) = self.members.lock() {
+            m.sinks
+                .retain(|_, candidate| !std::ptr::eq(&**candidate, sink));
+        }
+    }
+    fn unadvise(&self, cookie: u32) -> AbiResult<()> {
+        let mut m = self.members.lock().map_err(|_| error(E_UNEXPECTED))?;
+        let sink = m
+            .sinks
+            .remove(&cookie)
+            .ok_or_else(|| error(NO_CONNECTION))?;
+        close_sink(&sink);
+        Ok(())
+    }
+    fn enable(&self, set: Option<bool>) -> AbiResult<bool> {
+        let m = self.members.lock().map_err(|_| error(E_UNEXPECTED))?;
+        if m.closed || m.sinks.is_empty() {
+            return Err(error(NO_CONNECTION));
+        }
+        if let Some(value) = set {
+            self.enabled.store(value, Ordering::Release);
+            self.invalidate();
+            if !value {
+                for sink in m.sinks.values() {
+                    sink.queue
+                        .lock()
+                        .map_err(|_| error(E_UNEXPECTED))?
+                        .clear_latest();
+                }
+            }
+        }
+        Ok(self.enabled.load(Ordering::Acquire))
+    }
+    fn prepare(&self) -> AbiResult<Preparation<'_, Arc<Frame>>> {
+        Members::prepare(&self.members).map_err(admission_error)
+    }
+    fn cancel(&self, id: u32) -> AbiResult<()> {
+        let mut m = self.members.lock().map_err(|_| error(E_UNEXPECTED))?;
