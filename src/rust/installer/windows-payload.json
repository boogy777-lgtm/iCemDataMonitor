{
  "schema_version": 2,
  "target": "x86_64-pc-windows-msvc",
  "addin_directory": "addin",
  "binaries": [
    {
      "role": "host",
      "package": "icem-host-app",
      "bin": "icem-host-dev",
      "destination": "icem-host-dev.exe",
      "templates_directory": "templates"
    },
    {
      "role": "shell",
      "package": "icem-shell-app",
      "bin": "icem-shell-dev",
      "destination": "icem-shell-dev.exe"
    },
    {
      "role": "emulator",
      "package": "icem-emulator-app",
      "bin": "icem-emulator-engine-dev",
      "destination": "icem-emulator-engine-dev.exe",
      "templates_directory": "emulator/templates"
    },
    {
      "role": "opc-da-sidecar",
      "package": "icem-opc-da-sidecar",
      "bin": "icem-opc-da-sidecar",
      "destination": "icem-opc-da-sidecar.exe"
    }
  ],
  "files": [
    {
      "source": "src/rust/assets/iCemDataMonitor.ico",
      "destination": "assets/iCemDataMonitor.ico"
    },
    {
      "source": "src/rust/assets/iCemEmule.ico",
      "destination": "assets/iCemEmule.ico"
    },
    {
      "source": "installer/assets/Burservis_logo_cyr_red.png",
      "destination": "assets/Burservis_logo_cyr_red.png"
    },
    {
      "source": "src/rust/installer/windows/Start-Host.ps1",
      "destination": "Start-Host.ps1"
    },
    {
      "source": "src/rust/installer/windows/Start-Shell.ps1",
      "destination": "Start-Shell.ps1"
    },
    {
      "source": "src/rust/installer/windows/Start-Emulator.ps1",
      "destination": "Start-Emulator.ps1"
    },
    {
      "source": "src/rust/installer/windows/README-Windows.txt",
      "destination": "README-Windows.txt"
    },
    {
      "source": "templates/variable_registry.json",
      "destination": "templates/variable_registry.json"
    },
    {
      "source": "src/net/iCemDataMonitor.Plugins.Icem/templates/lantable_registry.json",
      "destination": "templates/lantable_registry.json"
    }
  ],
  "directories": [
    {
      "source": "src/net/iCemEmulator/templates",
      "destination": "emulator/templates",
      "pattern": "*.json"
    }
  ]
}
