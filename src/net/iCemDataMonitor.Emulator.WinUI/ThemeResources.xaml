        <Setter Property="Margin" Value="12,0,0,0"/>
    </Style>
    <!-- Framed list well (kit MacListBox: list bg + 0.6 separator frame, radius 6) -->
    <Style x:Key="MacListWell" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource MacListBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource MacSeparatorBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource MacStrokeControl}"/>
        <Setter Property="CornerRadius" Value="{StaticResource MacRadius}"/>
        <Setter Property="Padding" Value="2"/>
    </Style>

    <!-- в•ђв•ђв•ђ Button вЂ” full kit MacButton template (stock Fluent template
         replaced): 0.6 separator frame, radius 6, idle=hover fill,
         pressed darker, disabled dimmed. Accent (prominent) buttons keep
         the stock AccentButtonStyle вЂ” already kit-blue via AccentFillColor*. в•ђв•ђв•ђ -->
    <Style TargetType="Button">
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Padding" Value="{StaticResource MacButtonPadding}"/>
        <Setter Property="FontSize" Value="{StaticResource MacFontSizeBody}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontFamily" Value="{StaticResource MacFontFamily}"/>
        <Setter Property="Foreground" Value="{ThemeResource MacLabelBrush}"/>
        <Setter Property="Background" Value="{ThemeResource MacButtonBgIdleBrush}"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource MacFocusRingBrush}"/>
        <Setter Property="FocusVisualPrimaryThickness" Value="{StaticResource MacFocusRingThickness}"/>
        <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
        <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
        <Setter Property="FocusVisualMargin" Value="{StaticResource MacFocusRingMargin}"/>
        <Setter Property="CornerRadius" Value="{StaticResource MacRadius}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{ThemeResource MacSeparatorBrush}"
                            BorderThickness="{StaticResource MacStrokeControl}"
                            CornerRadius="{StaticResource MacRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Background" Value="{ThemeResource MacButtonBgIdleBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Background" Value="{ThemeResource MacButtonBgPressedBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Background" Value="{ThemeResource MacButtonBgDisabledBrush}"/>
                                        <Setter Target="Content.Foreground" Value="{ThemeResource MacLabelDisabledBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="Content"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTransitions="{TemplateBinding ContentTransitions}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- в•ђв•ђв•ђ AccentButtonStyle вЂ” kit MacButton .prominent: SAME geometry as
         the regular button (24h, r6, padding 16,0 в‡’ РѕРґРёРЅР°РєРѕРІС‹Рµ СЂР°Р·РјРµСЂС‹),
         accent fill, white text, hover = idle, pressed = darker accent +
         content opacity 0.8 (kit MacButtonPressedOpacity) в•ђв•ђв•ђ -->
    <Style x:Key="AccentButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Padding" Value="{StaticResource MacButtonPadding}"/>
        <Setter Property="FontSize" Value="{StaticResource MacFontSizeBody}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontFamily" Value="{StaticResource MacFontFamily}"/>
        <Setter Property="Foreground" Value="{ThemeResource MacButtonTextPreferredBrush}"/>
        <Setter Property="Background" Value="{ThemeResource MacAccentBrush}"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource MacFocusRingBrush}"/>
        <Setter Property="FocusVisualPrimaryThickness" Value="{StaticResource MacFocusRingThickness}"/>
        <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
        <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
        <Setter Property="FocusVisualMargin" Value="{StaticResource MacFocusRingMargin}"/>
        <Setter Property="CornerRadius" Value="{StaticResource MacRadius}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource MacRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Background" Value="{ThemeResource MacAccentBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Background" Value="{ThemeResource MacAccentPressedBrush}"/>
                                        <Setter Target="Content.Opacity" Value="0.8"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Background" Value="{ThemeResource MacButtonBgDisabledBrush}"/>
                                        <Setter Target="Content.Foreground" Value="{ThemeResource MacLabelDisabledBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="Content"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTransitions="{TemplateBinding ContentTransitions}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- в•ђв•ђв•ђ ComboBox вЂ” sizing only (stock template already consumes the
         mapped ControlFillColor*/ControlStrokeColor* brushes = button chrome) в•ђв•ђв•ђ -->
    <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource MacFocusRingBrush}"/>
        <Setter Property="FocusVisualPrimaryThickness" Value="{StaticResource MacFocusRingThickness}"/>
        <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
        <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
        <Setter Property="FocusVisualMargin" Value="{StaticResource MacFocusRingMargin}"/>
        <Setter Property="Padding" Value="{StaticResource MacComboBoxPadding}"/>
        <Setter Property="FontSize" Value="{StaticResource MacFontSizeBody}"/>
        <Setter Property="FontFamily" Value="{StaticResource MacFontFamily}"/>
    </Style>

    <!-- в•ђв•ђв•ђ ComboBoxItem вЂ” kit MacComboBoxItem (R13/R14): hover row fill =
         SOFT translucent accent, text STAYS primary; selected = ONLY the
         bright accent checkmark, no fill (orthogonal channels, no double
         highlight). Geometry: row border Margin 4,0 radius 5; check at x=6;
         text fixed at x=22. в•ђв•ђв•ђ -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="Padding" Value="6,0,10,0"/>
        <Setter Property="FontSize" Value="{StaticResource MacFontSizeBody}"/>
        <Setter Property="FontFamily" Value="{StaticResource MacFontFamily}"/>
        <Setter Property="Foreground" Value="{ThemeResource MacLabelBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="LayoutRoot" Background="Transparent" Margin="4,0"
                            CornerRadius="5">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource MacSoftHighlightBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource MacSoftHighlightBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="CheckGlyph.Visibility" Value="Visible"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOverSelected">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource MacSoftHighlightBrush}"/>
                                        <Setter Target="CheckGlyph.Visibility" Value="Visible"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PressedSelected">
                                    <VisualState.Setters>
                                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource MacSoftHighlightBrush}"/>
                                        <Setter Target="CheckGlyph.Visibility" Value="Visible"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Foreground" Value="{ThemeResource MacLabelDisabledBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid>
                            <TextBlock x:Name="CheckGlyph" Text="вњ“" Visibility="Collapsed"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"
                                       Margin="6,0,0,0" FontSize="{StaticResource MacFontSizeSecondary}"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource MacAccentBrush}"/>
                            <ContentPresenter x:Name="Content"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Margin="22,0,0,0"
                                              Padding="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- в•ђв•ђв•ђ SelectorBarItem вЂ” kit MacSegmentedItem: height 20, padding 10,0,
         font 13 w400, fg labels-primary ALWAYS; selected = soft accent fill +
         hairline ring (kit MacShadowControl), unselected = transparent,
         disabled = tertiary text. NO hover/press fills (reference has none). в•ђв•ђв•ђ -->
    <Style TargetType="SelectorBarItem">
        <Setter Property="MinHeight" Value="20"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource MacFocusRingBrush}"/>
        <Setter Property="FocusVisualPrimaryThickness" Value="{StaticResource MacFocusRingThickness}"/>
        <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
        <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
        <Setter Property="FocusVisualMargin" Value="{StaticResource MacFocusRingMargin}"/>
        <Setter Property="CornerRadius" Value="{StaticResource MacRadiusSegment}"/>
        <Setter Property="FontSize" Value="{StaticResource MacFontSizeBody}"/>
        <Setter Property="FontFamily" Value="{StaticResource MacFontFamily}"/>
        <Setter Property="Foreground" Value="{ThemeResource MacLabelBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="SelectorBarItem">
                    <Border x:Name="Root" Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="5">
                        <VisualStateManager.VisualStateGroups>
                            <!-- W2_StateContract: РџРћР›РќР«Р™ РєРѕРЅС‚СЂР°РєС‚ РёР· generic.xaml
                                 (WinUI 1.8, controls:SelectorBarItem) + СЃРІРµСЂРµРЅРѕ СЃРѕ
                                 СЃС‚СЂРѕРєР°РјРё Microsoft.UI.Xaml.Controls.dll. РРјРµРЅР°
                                 РќР• CommonStates-РїР»РѕСЃРєРёРµ (Selected/Normal), Р°
                                 РєРѕРјР±РёРЅРёСЂРѕРІР°РЅРЅС‹Рµ. GoToState РЅР° РѕС‚СЃСѓС‚СЃС‚РІСѓСЋС‰РµРµ РёРјСЏ
                                 РІРѕР·РІСЂР°С‰Р°РµС‚ false в€§ СЃРѕСЃС‚РѕСЏРЅРёРµ Р—РђР›РРџРђР•Рў (autopsy
                                 2026-08-19: С‚Р°Р±С‹ РєСЂР°СЃРёР»РёСЃСЊ РєСѓРјСѓР»СЏС‚РёРІРЅРѕ). -->
                            <VisualStateGroup x:Name="CombinedStates">
                                <VisualState x:Name="UnselectedNormal">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="Transparent"/>
                                        <Setter Target="Root.BorderBrush" Value="Transparent"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <!-- kit MacSegmented: NO hover/press fills (R9:
                                     Р°РєС‚РёРІРЅРѕРјСѓ/РЅРµР°РєС‚РёРІРЅРѕРјСѓ СЃРµРіРјРµРЅС‚Сѓ hover РЅРµ РїРѕР»РѕР¶РµРЅ) вЂ”
                                     СЃРѕСЃС‚РѕСЏРЅРёСЏ РѕР±СЉСЏРІР»РµРЅС‹, РІРёР·СѓР°Р» = reset -->
                                <VisualState x:Name="UnselectedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="Transparent"/>
                                        <Setter Target="Root.BorderBrush" Value="Transparent"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="UnselectedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="Transparent"/>
                                        <Setter Target="Root.BorderBrush" Value="Transparent"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedNormal">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource MacSoftHighlightBrush}"/>
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource MacPillRingBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource MacSoftHighlightBrush}"/>
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource MacPillRingBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource MacSoftHighlightBrush}"/>
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource MacPillRingBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="DisabledStates">
                                <VisualState x:Name="Enabled"/>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Foreground" Value="{ThemeResource MacLabel3Brush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <TextBlock x:Name="Content"
                                   Text="{TemplateBinding Text}"
                                   Margin="{TemplateBinding Padding}"
                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                   Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- W15 2026-08-28: MacToggleSwitch — stock WinUI 1.8 template parts
         (SwitchAreaGrid, SwitchKnobBounds, SwitchKnob, SwitchKnobOn/Off,
         KnobTranslateTransform, SwitchThumb, OuterBorder, OffContentPresenter,
         OnContentPresenter) so the ToggleSwitch CLASS wires its pointer
         handlers and IsOn flips. Mac look: track 38x24 pill r12, knob 18 white,
         travel 14, ON = accent, disabled = 0.5, ZERO hover effects (pure HIG).
         -->
    <Style TargetType="ToggleSwitch">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource MacFocusRingBrush}"/>
        <Setter Property="FocusVisualPrimaryThickness" Value="{StaticResource MacFocusRingThickness}"/>
        <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
        <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
        <Setter Property="FocusVisualMargin" Value="{StaticResource MacFocusRingMargin}"/>
        <Setter Property="CornerRadius" Value="{StaticResource MacRadiusPill}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleSwitch">
                    <Grid Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Target="OuterBorder.Fill" Value="{ThemeResource ToggleSwitchFillOff}"/>
                                        <Setter Target="OuterBorder.Stroke" Value="{ThemeResource ToggleSwitchStrokeOff}"/>
                                        <Setter Target="SwitchKnobBounds.Fill" Value="{ThemeResource ToggleSwitchFillOn}"/>
                                        <Setter Target="SwitchKnobBounds.Stroke" Value="{ThemeResource ToggleSwitchStrokeOn}"/>
                                        <Setter Target="SwitchAreaGrid.Background" Value="{ThemeResource ToggleSwitchContainerBackground}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="OuterBorder.Fill" Value="{ThemeResource ToggleSwitchFillOffPointerOver}"/>
                                        <Setter Target="OuterBorder.Stroke" Value="{ThemeResource ToggleSwitchStrokeOffPointerOver}"/>
                                        <Setter Target="SwitchKnobBounds.Fill" Value="{ThemeResource ToggleSwitchFillOnPointerOver}"/>
                                        <Setter Target="SwitchKnobBounds.Stroke" Value="{ThemeResource ToggleSwitchStrokeOnPointerOver}"/>
                                        <Setter Target="SwitchAreaGrid.Background" Value="{ThemeResource ToggleSwitchContainerBackgroundPointerOver}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="OuterBorder.Fill" Value="{ThemeResource ToggleSwitchFillOffPressed}"/>
                                        <Setter Target="OuterBorder.Stroke" Value="{ThemeResource ToggleSwitchStrokeOffPressed}"/>
                                        <Setter Target="SwitchKnobBounds.Fill" Value="{ThemeResource ToggleSwitchFillOnPressed}"/>
                                        <Setter Target="SwitchKnobBounds.Stroke" Value="{ThemeResource ToggleSwitchStrokeOnPressed}"/>
                                        <Setter Target="SwitchAreaGrid.Background" Value="{ThemeResource ToggleSwitchContainerBackgroundPressed}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="OuterBorder.Fill" Value="{ThemeResource ToggleSwitchFillOffDisabled}"/>
                                        <Setter Target="OuterBorder.Stroke" Value="{ThemeResource ToggleSwitchStrokeOffDisabled}"/>
                                        <Setter Target="SwitchKnobBounds.Fill" Value="{ThemeResource ToggleSwitchFillOnDisabled}"/>
                                        <Setter Target="SwitchKnobBounds.Stroke" Value="{ThemeResource ToggleSwitchStrokeOnDisabled}"/>
                                        <Setter Target="SwitchAreaGrid.Background" Value="{ThemeResource ToggleSwitchContainerBackgroundDisabled}"/>
                                        <Setter Target="Root.Opacity" Value="0.5"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ToggleStates">
                                <VisualState x:Name="Off"/>
                                <VisualState x:Name="On">
                                    <VisualState.Setters>
                                        <Setter Target="SwitchKnobBounds.Opacity" Value="1"/>
                                        <Setter Target="OffContentPresenter.Opacity" Value="0"/>
                                        <Setter Target="OnContentPresenter.Opacity" Value="1"/>
                                        <Setter Target="KnobTranslateTransform.X" Value="14"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ContentStates">
                                <VisualState x:Name="OffContent">
                                    <VisualState.Setters>
                                        <Setter Target="OffContentPresenter.Opacity" Value="1"/>
                                        <Setter Target="OnContentPresenter.Opacity" Value="0"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="OnContent">
                                    <VisualState.Setters>
                                        <Setter Target="OffContentPresenter.Opacity" Value="0"/>
                                        <Setter Target="OnContentPresenter.Opacity" Value="1"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid x:Name="Root">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid x:Name="SwitchAreaGrid" Grid.RowSpan="3" Grid.ColumnSpan="3"
                                  Margin="0" CornerRadius="{TemplateBinding CornerRadius}"
                                  Control.IsTemplateFocusTarget="True"
                                  Background="{ThemeResource ToggleSwitchContainerBackground}"/>

                            <ContentPresenter x:Name="OffContentPresenter" Grid.RowSpan="3" Grid.Column="2"
                                              Opacity="0" Foreground="{TemplateBinding Foreground}"
                                              IsHitTestVisible="False" Content="{TemplateBinding OffContent}"
                                              ContentTemplate="{TemplateBinding OffContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              AutomationProperties.AccessibilityView="Raw"/>
                            <ContentPresenter x:Name="OnContentPresenter" Grid.RowSpan="3" Grid.Column="2"
                                              Opacity="0" Foreground="{TemplateBinding Foreground}"
                                              IsHitTestVisible="False" Content="{TemplateBinding OnContent}"
                                              ContentTemplate="{TemplateBinding OnContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              AutomationProperties.AccessibilityView="Raw"/>

                            <Rectangle x:Name="OuterBorder" Grid.Row="1" Width="38" Height="24"
                                       RadiusX="12" RadiusY="12"
                                       Fill="{ThemeResource ToggleSwitchFillOff}"
                                       Stroke="{ThemeResource ToggleSwitchStrokeOff}"
                                       StrokeThickness="0"/>
                            <Rectangle x:Name="SwitchKnobBounds" Grid.Row="1" Width="38" Height="24"
                                       RadiusX="12" RadiusY="12"
                                       Fill="{ThemeResource ToggleSwitchFillOn}"
                                       Stroke="{ThemeResource ToggleSwitchStrokeOn}"
                                       StrokeThickness="0" Opacity="0"/>
                            <Border x:Name="SwitchKnob" Grid.Row="1"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Width="20" Height="20" Margin="2,0,0,0"
                                    Background="{ThemeResource ToggleSwitchKnobFillOff}"
                                    BorderBrush="{ThemeResource ToggleSwitchKnobStrokeOn}"
                                    BorderThickness="0" CornerRadius="10"
                                    >
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="KnobTranslateTransform" X="0"/>
                                    </Border.RenderTransform>
                                </Border>
                            <Thumb x:Name="SwitchThumb" Grid.RowSpan="3" Grid.ColumnSpan="3">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Rectangle Fill="Transparent"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- в•ђв•ђв•ђ TextBox вЂ” kit MacTextField: 24h, radius 5, border = separator
         0.6, padding 8,0 + vertical center, selection = soft accent в•ђв•ђв•ђ -->
    <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CornerRadius" Value="{StaticResource MacRadiusTextField}"/>
        <Setter Property="FontSize" Value="{StaticResource MacFontSizeBody}"/>
        <Setter Property="FontFamily" Value="{StaticResource MacFontFamily}"/>
    </Style>
    <!-- ListViewItem вЂ” kit MacListBoxItem: row 20h, padding 8,0
         (stock MinHeight=40 via ListViewItemMinHeight вЂ” СЃР»РёС€РєРѕРј Р¶РёСЂРЅРѕ РґР»СЏ
         РїР»РѕС‚РЅС‹С… telemetry-С‚Р°Р±Р»РёС†) -->
    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="MinHeight" Value="20"/>
        <Setter Property="Padding" Value="8,0"/>
    </Style>

    <!-- в•ђв•ђв•ђ ScrollBar вЂ” full kit MacScrollBar (overlay thumb-only): bar 8,
         thumb pill 8 r4, idle 30% / hover 45%, track invisible (hover =
         РµРґРІР° РІРёРґРёРјС‹Р№ quinary), line/page buttons = РЅРµРІРёРґРёРјС‹Рµ click-Р·РѕРЅС‹.
         W2_StateContract: РџРћР›РќР«Р™ РєРѕРЅС‚СЂР°РєС‚ РёР· generic.xaml WinUI 1.8
         (CommonStates {Normal, Disabled} + ScrollingIndicatorStates
         {TouchIndicator, MouseIndicator, NoIndicator} + ConsciousStates
         {Collapsed, Expanded, ExpandedWithoutAnimation,
         CollapsedWithoutAnimation}) Рё Р’РЎР• TemplatePart-РёРјРµРЅР° СЃС‚РѕРєР°
         (ScrollBar-РєРѕРґ РґРІРёРіР°РµС‚ thumb/page-РєРЅРѕРїРєРё РїРѕ РёРјРµРЅР°Рј). РџСЂРёС‡РёРЅР°
         СЂРµС‚РµРјРїР»РµР№С‚Р°, Р° РЅРµ resource-override: stock generic.xaml С‡РёС‚Р°РµС‚
         РіРµРѕРјРµС‚СЂРёСЋ С‡РµСЂРµР· StaticResource (ScrollBarSize Рё РґСЂ.) вЂ” page-СЃР»РѕРІР°СЂСЊ
         С‚СѓРґР° РЅРµ РґРѕС…РѕРґРёС‚ (autopsy W13.4: lane РѕСЃС‚Р°Р»СЃСЏ 12px РїСЂРё РѕРІРµСЂСЂР°Р№РґРµ). в•ђв•ђв•ђ -->
    <Style TargetType="ScrollBar">
        <Setter Property="MinWidth" Value="{StaticResource MacScrollBarSize}"/>
        <Setter Property="MinHeight" Value="{StaticResource MacScrollBarSize}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="Transparent"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}">
                        <Grid.Resources>
                            <!-- invisible click zones (kit MacScrollBarLineButton/PageButton) -->
                            <ControlTemplate x:Key="RepeatButtonTemplate" TargetType="RepeatButton">
                                <Grid x:Name="Root" Background="Transparent">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal"/>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </Grid>
                            </ControlTemplate>
                            <!-- pill thumb 8 r4 (kit: 30% idle в†’ 45% hover С‡РµСЂРµР·
                                 ConsciousStates-СЃРµС‚С‚РµСЂС‹ РЅР° Thumb.Background) -->
                            <ControlTemplate x:Key="VerticalThumbTemplate" TargetType="Thumb">
                                <Rectangle x:Name="ThumbVisual" Fill="{TemplateBinding Background}" RadiusX="{StaticResource MacScrollThumbRadius}" RadiusY="{StaticResource MacScrollThumbRadius}">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal"/>
                                            <VisualState x:Name="Disabled">
                                                <Storyboard>
                                                    <DoubleAnimation Duration="{StaticResource MacScrollFadeTime}" To="0" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="ThumbVisual"/>
                                                </Storyboard>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </Rectangle>
                            </ControlTemplate>
                            <ControlTemplate x:Key="HorizontalThumbTemplate" TargetType="Thumb">
                                <Rectangle x:Name="ThumbVisual" Fill="{TemplateBinding Background}" RadiusX="{StaticResource MacScrollThumbRadius}" RadiusY="{StaticResource MacScrollThumbRadius}">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal"/>
                                            <VisualState x:Name="Disabled">
                                                <Storyboard>
                                                    <DoubleAnimation Duration="{StaticResource MacScrollFadeTime}" To="0" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="ThumbVisual"/>
                                                </Storyboard>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </Rectangle>
                            </ControlTemplate>
                        </Grid.Resources>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.5"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ScrollingIndicatorStates">
                                <VisualState x:Name="TouchIndicator">
                                    <VisualState.Setters>
                                        <Setter Target="HorizontalRoot.Visibility" Value="Collapsed"/>
                                        <Setter Target="VerticalRoot.Visibility" Value="Collapsed"/>
                                        <Setter Target="HorizontalPanningRoot.Opacity" Value="1"/>
                                        <Setter Target="VerticalPanningRoot.Opacity" Value="1"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="MouseIndicator">
                                    <VisualState.Setters>
                                        <Setter Target="HorizontalPanningRoot.Visibility" Value="Collapsed"/>
                                        <Setter Target="VerticalPanningRoot.Visibility" Value="Collapsed"/>
                                        <Setter Target="HorizontalRoot.IsHitTestVisible" Value="True"/>
                                        <Setter Target="VerticalRoot.IsHitTestVisible" Value="True"/>
                                        <Setter Target="HorizontalThumb.Opacity" Value="1"/>
                                        <Setter Target="VerticalThumb.Opacity" Value="1"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <!-- auto-hide (macOS overlay): ScrollViewer РїРµСЂРµРІРѕРґРёС‚ СЃСЋРґР°
                                     РїРѕСЃР»Рµ 2s РїСЂРѕСЃС‚РѕСЏ вЂ” thumb/track РїР»Р°РІРЅРѕ РіР°СЃРЅСѓС‚ -->
                                <VisualState x:Name="NoIndicator">
                                    <VisualState.Setters>
                                        <Setter Target="HorizontalThumb.Background" Value="{ThemeResource MacScrollThumbBrush}"/>
                                        <Setter Target="VerticalThumb.Background" Value="{ThemeResource MacScrollThumbBrush}"/>
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimation Duration="{StaticResource MacScrollFadeTime}" Storyboard.TargetName="VerticalThumb" Storyboard.TargetProperty="Opacity" To="0"/>
                                        <DoubleAnimation Duration="{StaticResource MacScrollFadeTime}" Storyboard.TargetName="VerticalTrackRect" Storyboard.TargetProperty="Opacity" To="0"/>
                                        <DoubleAnimation Duration="{StaticResource MacScrollFadeTime}" Storyboard.TargetName="HorizontalThumb" Storyboard.TargetProperty="Opacity" To="0"/>
                                        <DoubleAnimation Duration="{StaticResource MacScrollFadeTime}" Storyboard.TargetName="HorizontalTrackRect" Storyboard.TargetProperty="Opacity" To="0"/>
                                        <DoubleAnimation Duration="{StaticResource MacScrollFadeTime}" Storyboard.TargetName="HorizontalPanningRoot" Storyboard.TargetProperty="Opacity" To="0"/>
                                        <DoubleAnimation Duration="{StaticResource MacScrollFadeTime}" Storyboard.TargetName="VerticalPanningRoot" Storyboard.TargetProperty="Opacity" To="0"/>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HorizontalRoot" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="{StaticResource MacScrollFadeTime}">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Collapsed</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="VerticalRoot" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="{StaticResource MacScrollFadeTime}">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Collapsed</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HorizontalPanningRoot" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="{StaticResource MacScrollFadeTime}">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Collapsed</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="VerticalPanningRoot" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="{StaticResource MacScrollFadeTime}">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Collapsed</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ConsciousStates">
                                <!-- kit: hover РїРѕ Р±Р°СЂСѓ = thumb 45% + РµРґРІР° РІРёРґРёРјС‹Р№ track;
                                     С€РёСЂРёРЅР° РќР• РјРµРЅСЏРµС‚СЃСЏ (8 РІСЃРµРіРґР° вЂ” overlay) -->
                                <VisualState x:Name="Collapsed">
                                    <VisualState.Setters>
                                        <Setter Target="HorizontalThumb.Background" Value="{ThemeResource MacScrollThumbBrush}"/>
                                        <Setter Target="VerticalThumb.Background" Value="{ThemeResource MacScrollThumbBrush}"/>
                                        <Setter Target="HorizontalTrackRect.Opacity" Value="0"/>
                                        <Setter Target="VerticalTrackRect.Opacity" Value="0"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Expanded">
                                    <VisualState.Setters>
                                        <Setter Target="HorizontalThumb.Background" Value="{ThemeResource MacScrollThumbHoverBrush}"/>
                                        <Setter Target="VerticalThumb.Background" Value="{ThemeResource MacScrollThumbHoverBrush}"/>
                                        <Setter Target="HorizontalTrackRect.Opacity" Value="1"/>
                                        <Setter Target="VerticalTrackRect.Opacity" Value="1"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="ExpandedWithoutAnimation">
                                    <VisualState.Setters>
                                        <Setter Target="HorizontalThumb.Background" Value="{ThemeResource MacScrollThumbHoverBrush}"/>
                                        <Setter Target="VerticalThumb.Background" Value="{ThemeResource MacScrollThumbHoverBrush}"/>
                                        <Setter Target="HorizontalTrackRect.Opacity" Value="1"/>
                                        <Setter Target="VerticalTrackRect.Opacity" Value="1"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CollapsedWithoutAnimation">
                                    <VisualState.Setters>
                                        <Setter Target="HorizontalThumb.Background" Value="{ThemeResource MacScrollThumbBrush}"/>
                                        <Setter Target="VerticalThumb.Background" Value="{ThemeResource MacScrollThumbBrush}"/>
                                        <Setter Target="HorizontalTrackRect.Opacity" Value="0"/>
                                        <Setter Target="VerticalTrackRect.Opacity" Value="0"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <!-- в•ђв•ђ layout = stock generic.xaml (РёРјРµРЅР°/РїРѕСЂСЏРґРѕРє С‡Р°СЃС‚РµР№
                             РѕР±СЏР·Р°С‚РµР»СЊРЅС‹ вЂ” ScrollBar code-behind РґРІРёРіР°РµС‚ РёС…) в•ђв•ђ -->
                        <Grid x:Name="HorizontalRoot" Background="Transparent" IsHitTestVisible="False" CornerRadius="{StaticResource MacRadiusSmall}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="HorizontalTrackRect" RadiusX="{StaticResource MacScrollThumbRadius}" RadiusY="{StaticResource MacScrollThumbRadius}" Opacity="0" Grid.ColumnSpan="5" Margin="0" Fill="{ThemeResource MacFillQuinaryBrush}"/>
                            <RepeatButton x:Name="HorizontalSmallDecrease" Grid.Column="0" Opacity="0" MinHeight="{StaticResource MacScrollBarSize}" IsTabStop="False" Interval="50" Template="{StaticResource RepeatButtonTemplate}" Width="{StaticResource MacScrollBarSize}" AllowFocusOnInteraction="False" VerticalAlignment="Center"/>
                            <RepeatButton x:Name="HorizontalLargeDecrease" Opacity="0" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsTabStop="False" Interval="50" Template="{StaticResource RepeatButtonTemplate}" Width="0" AllowFocusOnInteraction="False"/>
                            <Thumb x:Name="HorizontalThumb" Opacity="0" Grid.Column="2" Background="{ThemeResource MacScrollThumbBrush}" Template="{StaticResource HorizontalThumbTemplate}" Height="{StaticResource MacScrollBarSize}" MinWidth="{StaticResource MacScrollThumbMinLength}" AutomationProperties.AccessibilityView="Raw" RenderTransformOrigin="0.5,1">
                                <Thumb.RenderTransform>
                                    <TranslateTransform x:Name="HorizontalThumbTransform" Y="0"/>
                                </Thumb.RenderTransform>
                            </Thumb>
                            <RepeatButton x:Name="HorizontalLargeIncrease" Opacity="0" Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsTabStop="False" Interval="50" AllowFocusOnInteraction="False" Template="{StaticResource RepeatButtonTemplate}"/>
                            <RepeatButton x:Name="HorizontalSmallIncrease" Grid.Column="4" Opacity="0" MinHeight="{StaticResource MacScrollBarSize}" IsTabStop="False" Interval="50" Template="{StaticResource RepeatButtonTemplate}" Width="{StaticResource MacScrollBarSize}" AllowFocusOnInteraction="False" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid x:Name="HorizontalPanningRoot" MinWidth="{StaticResource MacScrollThumbMinLength}" Visibility="Collapsed" Opacity="0" CornerRadius="{StaticResource MacRadiusSmall}">
                            <Border x:Name="HorizontalPanningThumb" VerticalAlignment="Bottom" HorizontalAlignment="Left" Background="{ThemeResource MacScrollThumbBrush}" BorderThickness="0" Height="{StaticResource MacScrollPanningThumbSize}" MinWidth="{StaticResource MacScrollPanningThumbMinLength}" Margin="{StaticResource MacScrollPanningMarginH}"/>
                        </Grid>
                        <Grid x:Name="VerticalRoot" Background="Transparent" IsHitTestVisible="False" CornerRadius="{StaticResource MacRadiusSmall}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Rectangle x:Name="VerticalTrackRect" RadiusX="{StaticResource MacScrollThumbRadius}" RadiusY="{StaticResource MacScrollThumbRadius}" Opacity="0" Grid.RowSpan="5" Margin="0" Fill="{ThemeResource MacFillQuinaryBrush}"/>
                            <RepeatButton x:Name="VerticalSmallDecrease" Grid.Row="0" Opacity="0" Height="{StaticResource MacScrollBarSize}" MinWidth="{StaticResource MacScrollBarSize}" IsTabStop="False" Interval="50" Template="{StaticResource RepeatButtonTemplate}" HorizontalAlignment="Center"/>
                            <RepeatButton x:Name="VerticalLargeDecrease" Opacity="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="0" IsTabStop="False" Interval="50" Grid.Row="1" AllowFocusOnInteraction="False" Template="{StaticResource RepeatButtonTemplate}"/>
                            <Thumb x:Name="VerticalThumb" Opacity="0" Grid.Row="2" Background="{ThemeResource MacScrollThumbBrush}" Template="{StaticResource VerticalThumbTemplate}" Width="{StaticResource MacScrollBarSize}" MinHeight="{StaticResource MacScrollThumbMinLength}" AutomationProperties.AccessibilityView="Raw" RenderTransformOrigin="1,0.5">
                                <Thumb.RenderTransform>
                                    <TranslateTransform x:Name="VerticalThumbTransform" X="0"/>
                                </Thumb.RenderTransform>
                            </Thumb>
                            <RepeatButton x:Name="VerticalLargeIncrease" Opacity="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsTabStop="False" Interval="50" Grid.Row="3" AllowFocusOnInteraction="False" Template="{StaticResource RepeatButtonTemplate}"/>
                            <RepeatButton x:Name="VerticalSmallIncrease" Grid.Row="4" Opacity="0" Height="{StaticResource MacScrollBarSize}" MinWidth="{StaticResource MacScrollBarSize}" IsTabStop="False" Interval="50" Template="{StaticResource RepeatButtonTemplate}" HorizontalAlignment="Center"/>
                        </Grid>
                        <Grid x:Name="VerticalPanningRoot" MinHeight="{StaticResource MacScrollThumbMinLength}" Visibility="Collapsed" Opacity="0" CornerRadius="{StaticResource MacRadiusSmall}">
                            <Border x:Name="VerticalPanningThumb" VerticalAlignment="Top" HorizontalAlignment="Right" Background="{ThemeResource MacScrollThumbBrush}" BorderThickness="0" Width="{StaticResource MacScrollPanningThumbSize}" MinHeight="{StaticResource MacScrollPanningThumbMinLength}" Margin="{StaticResource MacScrollPanningMarginV}"/>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
