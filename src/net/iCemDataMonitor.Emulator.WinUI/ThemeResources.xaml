    <x:Double x:Key="ScrollBarVerticalThumbMinHeight">24</x:Double>
    <x:Double x:Key="ScrollBarHorizontalThumbMinWidth">24</x:Double>
    <x:Double x:Key="ScrollBarThumbStrokeThickness">0</x:Double>
    <CornerRadius x:Key="ScrollBarCornerRadius">4</CornerRadius>
    <!-- MacScrollBar design tokens (kit Metrics/MacScrollBar.axaml) -->
    <x:Double x:Key="MacScrollBarSize">8</x:Double>
    <x:Double x:Key="MacScrollThumbMinLength">24</x:Double>
    <x:Double x:Key="MacScrollThumbRadius">4</x:Double>
    <x:Double x:Key="MacScrollPanningThumbSize">2</x:Double>
    <x:Double x:Key="MacScrollPanningThumbMinLength">32</x:Double>
    <Thickness x:Key="MacScrollPanningMarginH">0,2,0,2</Thickness>
    <Thickness x:Key="MacScrollPanningMarginV">2,0,2,0</Thickness>
    <x:String x:Key="MacScrollFadeTime">0:0:0.3</x:String>
    <!-- Content inset СЃРїРёСЃРєР° РѕС‚ lane СЃРєСЂРѕР»Р»Р±Р°СЂР° (W13.4: uom-РєРѕР»РѕРЅРєР° РєР°СЃР°Р»Р°СЃСЊ
         thumb вЂ” lane ScrollViewer СЂРµР·РµСЂРІРёСЂСѓРµС‚, Р° Р—РђР—РћР  РЅРµС‚). РџСЂР°РІС‹Р№ РѕС‚СЃС‚СѓРї =
         MacSpacingS. РџСЂРёРјРµРЅСЏС‚СЊ С‡РµСЂРµР· ListView.Padding (stock template
         РїСЂРѕР±СЂР°СЃС‹РІР°РµС‚ РІ ItemsPresenter.Padding). -->
    <Thickness x:Key="MacListScrollInset">0,0,8,0</Thickness>
    <!-- Focus ring (kit MacButtonFocusRingShadow: 0 0 3 2.5 accent О±0.35; blur 3
         РІ WinUI РЅРµРґРѕСЃС‚СѓРїРµРЅ в‡’ РїР»РѕСЃРєРѕРµ РєРѕР»СЊС†Рѕ spread 2.5, РѕС‚РєР»РѕРЅРµРЅРёРµ Р·Р°С„РёРєСЃРёСЂРѕРІР°РЅРѕ).
         Р РµР°Р»РёР·Р°С†РёСЏ = framework focus visuals (UseSystemFocusVisuals): СЂРёСЃСѓСЋС‚СЃСЏ
         РўРћР›Р¬РљРћ РїСЂРё keyboard-focus (= kit :focus-visible), pointer-click СЂРёРЅРі РЅРµ
         РїРѕРєР°Р·С‹РІР°РµС‚; template-РЅРµР·Р°РІРёСЃРёРјС‹, CornerRadius Р±РµСЂС‘С‚СЃСЏ РёР· СЃРІРѕР№СЃС‚РІР° РєРѕРЅС‚СЂРѕР»Р°. -->
    <Thickness x:Key="MacFocusRingThickness">2.5</Thickness>
    <Thickness x:Key="MacFocusRingMargin">-2.5</Thickness>

    <!-- W14: РѕРїС‚РёС‡РµСЃРєР°СЏ С†РµРЅС‚СЂРѕРІРєР° С‚РµРєСЃС‚Р° (Р¶Р°Р»РѕР±С‹ В«РЅРµ РїРѕ С†РµРЅС‚СЂСѓ РІС‹СЃРѕС‚С‹В»).
         Р—Р°РјРµСЂ РїРёРєСЃРµР»РµР№ (autopsy 2026-08-20): РїСЂРё СЃРёРјРјРµС‚СЂРёС‡РЅРѕРј padding 16,0
         РіР»РёС„С‹ Segoe UI Variable Text 13pt СЃРёРґСЏС‚ РЅР° 1.5вЂ“2.5px РќРР–Р• РіРµРѕРјРµС‚СЂРёРё
         (line-gap С€СЂРёС„С‚Р°). РљРѕРјРїРµРЅСЃР°С†РёСЏ = РЅРёР¶РЅРёР№ РїР°РґРґРёРЅРі +3 в‡’ С‚РµРєСЃС‚ РІРІРµСЂС… 1.5px.
         ComboBox: VerticalContentAlignment=Center РІ СЃС‚РёР»Рµ (СЃС‚РѕРєРѕРІС‹Р№ РґРµС„РѕР»С‚
         РїСЂРёР¶РёРјР°Р» С‚РµРєСЃС‚ Рє РІРµСЂС…Сѓ) + СЃРёРјРјРµС‚СЂРёС‡РЅС‹Р№ token-РїР°РґРґРёРЅРі. -->
    <Thickness x:Key="MacButtonPadding">16,0,16,3</Thickness>
    <Thickness x:Key="MacComboBoxPadding">12,0,12,0</Thickness>

    <!-- в•ђв•ђв•ђ Card (kit MacGroupBox: transparent fill, 0.6 separator frame,
         radius 8 вЂ” caption goes ABOVE the card, System Settings style) в•ђв•ђв•ђ -->
    <Style x:Key="MacCard" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{ThemeResource MacSeparatorBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource MacStrokeControl}"/>
        <Setter Property="CornerRadius" Value="{StaticResource MacRadiusLarge}"/>
        <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="MacCardCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource MacFontSizeCaption}"/>
