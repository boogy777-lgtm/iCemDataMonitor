<Project Sdk="Microsoft.NET.Sdk">

  <!--
    E.2/E.2.1 (W19): the host gets its OWN tray.
    2026-09-01 (owner decree «Блок 2 п.4: миграция на winui-трей или
    H.NotifyIcon»): the WinForms NotifyIcon is REPLACED by H.NotifyIcon.Core
    — a pure-Win32 tray (own message-loop thread inside TrayIconWithContextMenu).
    Reason: UseWindowsForms blocks PublishTrimmed entirely (the framework's
    own docs: WinForms is not trim-compatible), and trimming is the −25-30 MB
    lever on the self-contained single-file host. With WinForms gone the TFM
    drops back to PLAIN net10.0 (net10.0-windows was required ONLY for
    UseWindowsForms, NETSDK1136) — the icon handle path uses
    System.Drawing.Primitives (in Microsoft.NETCore.App), the console
    visibility code is raw P/Invoke. Ripples: Host.Tests returns to net10.0;
    HeadlessHygieneTests FLIP — System.Windows.Forms/UseWindowsForms move to
    the BANNED list, H.NotifyIcon leaves it (positive-sanity guard asserts
    the new tray plumbing exists).
    2026-09-02 amendment (owner decree «убераем self contained»): the publish
    is FRAMEWORK-DEPENDENT again (trimming/single-file retired with the
    decree) — the H.NotifyIcon.Core tray stays regardless: zero UI-framework
    dependency remains correct on its own merits.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>iCemDataMonitor.Host</RootNamespace>
    <AssemblyName>iCemDataMonitor.Host</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!--
      2026-08-28 (owner request): autostart must be HUMAN-controllable via
      Task Manager → Startup apps. That list shows the exe's FileDescription
      (MSBuild maps AssemblyTitle onto it) as the friendly entry name —
      without it the raw "iCemDataMonitor.Host" exe name shows instead.
    -->
    <AssemblyTitle>iCem Data Monitor Host</AssemblyTitle>
    <Product>iCem Data Monitor</Product>
  </PropertyGroup>

  <!--
    E.2.0 (asset reuse law): the tray icon is the EXISTING application asset
    (server-dotnet\assets\iCemDataMonitor.ico, Station.Tools.IconGen output —
    the same file Shell.WinUI uses). Embedded resource = deployment-proof (no
    side-by-side file resolution needed). NO new artwork.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\assets\iCemDataMonitor.ico" LogicalName="iCemDataMonitor.Host.tray.ico" />
  </ItemGroup>

  <!-- Kestrel + hosting come from the shared framework (no package drift).
       2026-08-27 (corrected decree «Web - удали (контрол sim)» = remove the
       sim control from the page, not the page): the web/SPA layer is RESTORED
       — Grpc.AspNetCore.Web is back so browser clients reach gRPC over
       gRPC-Web (server middleware, DefaultEnabled).
       2026-09-01 (owner decree «Блок 2 п.4»): H.NotifyIcon.Core replaces the
       WinForms tray — trim-compatible (declared Trimming/NativeAOT support),
       zero UI-framework dependency, deterministic name-based tray Guid
       (path-independent, survives install-folder moves). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Grpc.AspNetCore.Web" Version="2.71.0" />
    <PackageReference Include="H.NotifyIcon" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\iCemDataMonitor.Contracts\iCemDataMonitor.Contracts.csproj" />
    <ProjectReference Include="..\iCemDataMonitor.Host.Core\iCemDataMonitor.Host.Core.csproj" />
    <!--
      2026-08-31 (owner decree «пункт 3»): the CLI is MERGED into this exe
      (CliMode\CliForwarder — the retired iCemDataMonitor.Cli project's code,
      moved verbatim). Cli mode is a THIN FORWARDER over the host named pipe,
      so the host now references the same client library the shell uses:
      GrpcHostClient + EnsureHost + HostProcessLauncher. The cli-mode code
      path still touches NO bus/MMF itself — one RPC per command, then exit.
    -->
    <ProjectReference Include="..\iCemDataMonitor.HostClient\iCemDataMonitor.HostClient.csproj" />
  </ItemGroup>

  <!-- §15.7(a) test seam: the console-visibility service's Win32 boundary
       (probe/executor delegates) is internal — Host.Tests injects recording
       doubles so unit tests never AllocConsole/hide windows in the testhost. -->
  <ItemGroup>
    <InternalsVisibleTo Include="iCemDataMonitor.Host.Tests" />
  </ItemGroup>

  <!--
    2026-08-27 RESTORED (corrected decree): the SPA dashboard wwwroot (static
    index.html/main.css/main.js + favicon) ships next to the exe — ContentRoot
    is pinned to AppContext.BaseDirectory (Э6 failure law: never rely on the
    launch cwd), so the static files MUST deploy into the output/publish dir.
    Sim control stays removed from the dashboard page (that was the decree).
  -->
  <ItemGroup>
    <Content Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    MSI post-install scripts (owner request 2026-08-26): the installer's
    OptionsDlg offers desktop-shortcut / autostart checkboxes; a checked box
    runs the matching script from the installed iCemMonitor\scripts\ folder.
    They ride the publish output, so gen-payload.ps1 harvests them into the
    MSI automatically. Intentionally trivial (one action per script).
  -->
  <ItemGroup>
    <Content Include="scripts\**" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
