<Project Sdk="Microsoft.NET.Sdk">

  <!-- W10: UI-neutral host core — shared by the WinForms tray and the WinUI 3
       shell: layer toggle controller, health monitor, ASP.NET endpoints.
       2026-08-27: engine supervision DELETED (the emulator is now a SEPARATE
       INDEPENDENT app with its own exe/UI/CLI — the host never launches or
       supervises it). Emulator.Core reference and the CliWrap launcher went
       with it; no process launch remains in this project. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>iCemDataMonitor.Host.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- BusHealthMonitor.Probe is internal for direct verdict tests (same
       pattern as Data/Sdk/Core/Transport/Cli InternalsVisibleTo). -->
  <ItemGroup>
    <InternalsVisibleTo Include="iCemDataMonitor.Host.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\iCemDataMonitor.Core\iCemDataMonitor.Core.csproj" />
    <ProjectReference Include="..\iCemDataMonitor.Data\iCemDataMonitor.Data.csproj" />
    <ProjectReference Include="..\iCemDataMonitor.Sdk\iCemDataMonitor.Sdk.csproj" />
    <ProjectReference Include="..\iCemDataMonitor.Transport\iCemDataMonitor.Transport.csproj" />
    <ProjectReference Include="..\iCemDataMonitor.Plugins.Icem\iCemDataMonitor.Plugins.Icem.csproj" />
  </ItemGroup>

</Project>
