<Window
    x:Class="iCemDataMonitor.Shell.WinUI.BootSplashWindow"
    xmlns:local="using:iCemDataMonitor.Shell.WinUI"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- W21.4: splashscreen = MIRROR of the host boot stages as CHECKBOXES
         (owner decree: «нужны не строки а этапы … splashscreen зеркало =
         чекбокс = этап пройден»). Stages arrive via SubscribeBootStages
         (replay + live) — the host is the source of truth, the splash is dumb. -->
    <Grid Padding="28,22" RowSpacing="14" Background="{ThemeResource MacWindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Запуск iCemDataMonitor.Host"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{ThemeResource MacLabelBrush}"/>
            <TextBlock Text="этапы загрузки сервера (источник правды — host)"
                       FontSize="12"
                       Foreground="{ThemeResource MacLabel2Brush}"/>
        </StackPanel>

        <!-- Rows are built in CODE-BEINDDED (BuildStageRow): the WinUI 3 XAML
             compiler (WASDK 1.8) failed to resolve local x:DataType for
             x:Bind in this template (WMC1111), so no DataTemplate is used —
             deterministic code construction, zero reflection bindings. -->
        <StackPanel x:Name="StagesHost" Grid.Row="1" Spacing="2"/>

        <TextBlock x:Name="FooterLine" Grid.Row="2" FontSize="11"
                   Foreground="{ThemeResource MacLabel2Brush}"
                   Text="ожидание ответа хоста…"/>
    </Grid>
</Window>
