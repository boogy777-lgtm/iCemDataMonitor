+fn validate_profile(deadband: f32, locale: u32) -> Result<()> {
+    if !deadband.is_finite() || !(0.0..=100.0).contains(&deadband) || locale != 0 {
+        return Err(code_error(E_INVALIDARG));
+    }
+    if deadband != 0.0 {
+        return Err(code_error(HRESULT(0xc0040400_u32.cast_signed())));
+    }
+    Ok(())
