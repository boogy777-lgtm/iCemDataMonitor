+            kind: Kind::Cancel,
+            transaction: frame.transaction,
+            group: frame.group,
+            samples: Vec::new(),
+            revision: 0,
+            epoch: 0,
+        });
+        for (q, (_, id)) in queues.iter_mut().zip(&sinks) {
+            q.cancel(*id, frame.clone())
+                .map_err(|_| error(E_UNEXPECTED))?;
+        }
+        drop(queues);
+        m.requests.remove(&id);
+        Ok(())
+    }
