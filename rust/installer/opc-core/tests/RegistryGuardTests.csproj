<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType><AssemblyName>icem-opc-guard-tests</AssemblyName>
    <StartupObject>Icem.OpcCoreGuard.RegistryGuardTests</StartupObject>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion><PlatformTarget>x64</PlatformTarget>
    <FrameworkPathOverride>C:\Windows\Microsoft.NET\Framework64\v4.0.30319</FrameworkPathOverride>
    <LangVersion>8.0</LangVersion><Optimize>true</Optimize><DebugType>none</DebugType>
    <Deterministic>true</Deterministic><WarningLevel>4</WarningLevel><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System"/><Reference Include="System.Core"/>
    <Compile Include="RegistryGuardTests.cs"/><Compile Include="../RegistryGuard.cs"/>
    <Compile Include="NativeClientQuery.cs"/>
    <EmbeddedResource Include="../opc-component-codes.txt"><LogicalName>opc-components.txt</LogicalName></EmbeddedResource>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
