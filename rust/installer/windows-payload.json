{
  "schema_version": 2,
  "target": "x86_64-pc-windows-msvc",
  "addin_directory": "addin",
  "binaries": [
    { "role": "host", "package": "icem-host-app", "bin": "icem-host-dev", "destination": "icem-host-dev.exe" },
    { "role": "shell", "package": "icem-shell-app", "bin": "icem-shell-dev", "destination": "icem-shell-dev.exe" },
    { "role": "emulator", "package": "icem-emulator-app", "bin": "icem-emulator-engine-dev", "destination": "icem-emulator-engine-dev.exe" }
  ],
  "files": [
    { "source": "rust/assets/iCemDataMonitor.ico", "destination": "assets/iCemDataMonitor.ico" },
    { "source": "rust/assets/iCemEmule.ico", "destination": "assets/iCemEmule.ico" },
    { "source": "installer/assets/Burservis_logo_cyr_red.png", "destination": "assets/Burservis_logo_cyr_red.png" },
    { "source": "rust/installer/windows/Start-Host.ps1", "destination": "Start-Host.ps1" },
    { "source": "rust/installer/windows/Start-Shell.ps1", "destination": "Start-Shell.ps1" },
    { "source": "rust/installer/windows/Start-Emulator.ps1", "destination": "Start-Emulator.ps1" },
    { "source": "rust/installer/windows/README-Windows.txt", "destination": "README-Windows.txt" }
  ],
  "directories": [
    { "source": "iCemEmulator/templates", "destination": "templates", "pattern": "*.json" }
  ]
}
